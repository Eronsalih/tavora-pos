# Tavora backend (local development without Docker).
# Copy to backend/.env
APP_ENV=development

# Names must match app/core/config.py
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=tavora

# Generate a long random value:  openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated extra frontend origins (localhost:5173 is allowed by default)
CORS_ORIGINS=

# Subscription prices in euro cents (defaults: 9.99 / 29.99 / 49.99)
TAVORA_STARTER_PRICE_MINOR=999
TAVORA_STANDARD_PRICE_MINOR=2999
TAVORA_PRO_PRICE_MINOR=4999

# Paddle Billing
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
PADDLE_CHECKOUT_BASE_URL=
PADDLE_PRICE_ID_STARTER_MONTHLY=
PADDLE_PRICE_ID_STARTER_YEARLY=
PADDLE_PRICE_ID_STANDARD_MONTHLY=
PADDLE_PRICE_ID_STANDARD_YEARLY=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_YEARLY=
